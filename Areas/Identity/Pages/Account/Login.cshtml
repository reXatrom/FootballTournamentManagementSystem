@page "/account/login"
@model FootballTournamentManagementSystem.Areas.Identity.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Log in";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FootballTournamentManagementSystem</title>
    <link rel="stylesheet" href="/bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="/app.css" />
</head>
<body class="account-page">
    <main class="account-shell">
        <section class="account-card account-card-login">
            <p class="eyebrow">Welcome back</p>
            <h1>Sign in</h1>

            <form method="post" class="account-form">
                <input type="hidden" asp-for="ReturnUrl" />
                <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

                <div class="account-field">
                    <label asp-for="Input.Email"></label>
                    <input asp-for="Input.Email" autocomplete="email" />
                    <span asp-validation-for="Input.Email" class="validation-message"></span>
                </div>

                <div class="account-field">
                    <label asp-for="Input.Password"></label>
                    <input asp-for="Input.Password" autocomplete="current-password" />
                    <span asp-validation-for="Input.Password" class="validation-message"></span>
                </div>

                <label class="checkbox-label">
                    <input asp-for="Input.RememberMe" />
                    <span>Remember me</span>
                </label>

                <button type="submit">Sign in</button>
            </form>

            <p class="account-switch">
                <a asp-page="/Account/Register">Create a new account</a>
            </p>
        </section>
    </main>
</body>
</html>

