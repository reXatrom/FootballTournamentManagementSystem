@page "/account/login"
@model FootballTournamentManagementSystem.Areas.Identity.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Log in";
}

<main class="account-shell">
    <section class="account-intro">
        <span class="account-kicker">Football Tournament Management</span>
        <h1>Welcome back.</h1>
        <p>Keep fixtures moving, track every result, and stay close to the competition.</p>
        <div class="account-scoreline" aria-hidden="true">
            <span>FTMS</span>
            <strong>01</strong>
        </div>
    </section>

    <section class="account-panel">
        <p class="eyebrow">Member access</p>
        <h2>Sign in</h2>
        <p class="account-muted">Use your tournament account to continue.</p>
        <form method="post" class="account-form">
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

            <div class="account-field">
                <label asp-for="Input.Email"></label>
                <input asp-for="Input.Email" autocomplete="email" />
                <span asp-validation-for="Input.Email" class="validation-message"></span>
            </div>

            <div class="account-field">
                <label asp-for="Input.Password"></label>
                <input asp-for="Input.Password" autocomplete="current-password" />
                <span asp-validation-for="Input.Password" class="validation-message"></span>
            </div>

            <label class="checkbox-label">
                <input asp-for="Input.RememberMe" />
                Remember me
            </label>

            <button type="submit">Sign in</button>
        </form>
        <p class="account-switch">New to the tournament desk? <a asp-page="/Account/Register">Create an account</a></p>
    </section>
</main>

