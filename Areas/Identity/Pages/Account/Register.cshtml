@page "/account/register"
@model FootballTournamentManagementSystem.Areas.Identity.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Register";
}

<main class="account-shell account-shell-register">
    <section class="account-intro">
        <span class="account-kicker">Build your matchday</span>
        <h1>Your team starts here.</h1>
        <p>Create your account to follow tournaments, teams, fixtures, and match moments in one place.</p>
        <div class="account-scoreline" aria-hidden="true">
            <span>NEW SEASON</span>
            <strong>24</strong>
        </div>
    </section>

    <section class="account-panel">
        <p class="eyebrow">Create profile</p>
        <h2>Sign up</h2>
        <p class="account-muted">Register to participate in football tournaments.</p>
        <form method="post" class="account-form">
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

            <div class="account-field">
                <label asp-for="Input.FullName"></label>
                <input asp-for="Input.FullName" autocomplete="name" />
                <span asp-validation-for="Input.FullName" class="validation-message"></span>
            </div>

            <div class="account-field">
                <label asp-for="Input.Email"></label>
                <input asp-for="Input.Email" autocomplete="email" />
                <span asp-validation-for="Input.Email" class="validation-message"></span>
            </div>

            <div class="account-field">
                <label asp-for="Input.Password"></label>
                <input asp-for="Input.Password" autocomplete="new-password" />
                <span asp-validation-for="Input.Password" class="validation-message"></span>
            </div>

            <div class="account-field">
                <label asp-for="Input.ConfirmPassword"></label>
                <input asp-for="Input.ConfirmPassword" autocomplete="new-password" />
                <span asp-validation-for="Input.ConfirmPassword" class="validation-message"></span>
            </div>

            <button type="submit">Create account</button>
        </form>
        <p class="account-switch">Already have an account? <a asp-page="/Account/Login">Sign in</a></p>
    </section>
</main>

