@page "/tournaments"
@rendermode InteractiveServer
@using FootballTournamentManagementSystem.Data
@using FootballTournamentManagementSystem.Models
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@inject ICurrentUserDbContextFactory DbFactory
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Tournaments</PageTitle>

@if (Saved == "1")
{
    <p class="panel-muted">Changes saved.</p>
}

<div class="page-heading">
    <div>
        <p class="eyebrow">Competition calendar</p>
        <h1 class="page-title">Tournaments</h1>
        <p class="page-subtitle">Browse upcoming and completed football competitions.</p>
    </div>
    <a class="btn btn-primary" href="/tournaments/create">Create tournament</a>
</div>

@if (errorMessage is not null)
{
    <section class="empty-state"><h2>Unable to load tournaments</h2><p>@errorMessage</p></section>
}
else if (tournaments is null)
{
    <p>Loading tournaments...</p>
}
else if (tournaments.Count == 0)
{
    <section class="empty-state">
        <h2>No tournaments yet</h2>
        <p>The tournament calendar is ready for its first competition.</p>
    </section>
}
else
{
    <div class="tournament-grid">
        @foreach (var tournament in tournaments)
        {
            <article class="tournament-card">
                <div class="tournament-card-header">
                    <span class="status-badge status-@tournament.Status.ToString().ToLowerInvariant()">@tournament.Status</span>
                    <span>@tournament.Location</span>
                </div>
                <h2>@tournament.Name</h2>
                <p>@tournament.Description</p>
                <div class="tournament-dates">
                    <strong>@tournament.StartDate.ToString("MMM d, yyyy")</strong>
                    <span>to</span>
                    <strong>@tournament.EndDate.ToString("MMM d, yyyy")</strong>
                </div>
                <p class="panel-muted">Created by @tournament.CreatedByUser.FullName · @tournament.CreatedAt.ToLocalTime().ToString("g")</p>
                <div class="card-actions">
                    <a href="/tournaments/@tournament.Id">Details</a>
                    @if (CanManage(tournament))
                    {
                            <a href="/tournaments/edit/@tournament.Id">Edit</a>
                            <a href="/tournaments/delete/@tournament.Id">Delete</a>
                    }
                </div>
            </article>
        }
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "saved")]
    public string? Saved { get; set; }

    private List<Tournament>? tournaments;
    private string? errorMessage;
    private string? currentUserId;
    private bool isAdmin;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
            currentUserId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            isAdmin = user.IsInRole("Admin");
            await using var db = await DbFactory.CreateDbContextAsync();
            tournaments = await db.Tournaments
                .AsNoTracking()
                .Include(tournament => tournament.CreatedByUser)
                .OrderBy(tournament => tournament.StartDate)
                .ToListAsync();
        }
        catch
        {
            errorMessage = "Please try again later.";
        }
    }

    private bool CanManage(IOwnedRecord record) => isAdmin || record.CreatedByUserId == currentUserId;
}
