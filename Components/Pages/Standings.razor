@page "/standings"
@rendermode InteractiveServer
@using FootballTournamentManagementSystem.Data
@using FootballTournamentManagementSystem.Models
@using Microsoft.EntityFrameworkCore
@inject ICurrentUserDbContextFactory DbFactory

<PageTitle>Standings</PageTitle>

<div class="page-heading">
    <div>
        <p class="eyebrow">Competition table</p>
        <h1 class="page-title">Standings</h1>
        <p class="page-subtitle">Track points, goals scored, and league positions across tournaments.</p>
    </div>
</div>

@if (errorMessage is not null)
{
    <section class="empty-state"><h2>Unable to load standings</h2><p>@errorMessage</p></section>
}
else if (tournaments is null)
{
    <p>Loading standings...</p>
}
else if (tournaments.Count == 0)
{
    <section class="empty-state">
        <h2>No standings available</h2>
        <p>Create a tournament and schedule matches to generate a points table.</p>
    </section>
}
else
{
    <div class="league-list">
        @foreach (var tournament in tournaments)
        {
            var table = standingsByTournament.TryGetValue(tournament.Id, out var rows) ? rows : new List<StandingsRow>();
            <section class="standings-panel">
            <div class="panel-heading">
                <div>
                    <p class="eyebrow">@tournament.Location</p>
                    <h2>@tournament.Name</h2>
                </div>
                <span class="status-badge status-@tournament.Status.ToString().ToLowerInvariant()">@tournament.Status</span>
            </div>

            @if (table.Count == 0)
            {
                <p class="panel-muted">No matches played yet for this tournament.</p>
            }
            else
            {
                <div class="table-wrapper">
                    <table class="player-table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Team</th>
                                <th>P</th>
                                <th>W</th>
                                <th>D</th>
                                <th>L</th>
                                <th>GF</th>
                                <th>GA</th>
                                <th>GD</th>
                                <th>Pts</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in table)
                            {
                                <tr>
                                    <td>@row.Position</td>
                                    <td><strong>@row.TeamName</strong></td>
                                    <td>@row.Played</td>
                                    <td>@row.Wins</td>
                                    <td>@row.Draws</td>
                                    <td>@row.Losses</td>
                                    <td>@row.GoalsFor</td>
                                    <td>@row.GoalsAgainst</td>
                                    <td>@row.GoalDifference</td>
                                    <td><strong>@row.Points</strong></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            @{
                var leaders = leadersByTournament.TryGetValue(tournament.Id, out var tournamentLeaders)
                    ? tournamentLeaders
                    : new TournamentLeaders();
            }
            <div class="event-list">
                <section class="event-group">
                    <div class="event-group-heading">
                        <h2>Goal scorers</h2>
                    </div>
                    @if (leaders.GoalScorers.Count == 0)
                    {
                        <p class="panel-muted">No goals recorded yet.</p>
                    }
                    else
                    {
                        @foreach (var leader in leaders.GoalScorers)
                        {
                            <div class="event-row">
                                <strong>@leader.PlayerName</strong>
                                <span>@leader.TeamName</span>
                                <span>@leader.Count goals</span>
                            </div>
                        }
                    }
                </section>

                <section class="event-group">
                    <div class="event-group-heading">
                        <h2>Assist providers</h2>
                    </div>
                    @if (leaders.AssistProviders.Count == 0)
                    {
                        <p class="panel-muted">No assists recorded yet.</p>
                    }
                    else
                    {
                        @foreach (var leader in leaders.AssistProviders)
                        {
                            <div class="event-row">
                                <strong>@leader.PlayerName</strong>
                                <span>@leader.TeamName</span>
                                <span>@leader.Count assists</span>
                            </div>
                        }
                    }
                </section>
            </div>
            </section>
        }
    </div>
}

@code {
    private List<Tournament>? tournaments;
    private Dictionary<int, List<StandingsRow>> standingsByTournament = new();
    private Dictionary<int, TournamentLeaders> leadersByTournament = new();
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            tournaments = await db.Tournaments
                .AsNoTracking()
                .OrderBy(t => t.StartDate)
                .ToListAsync();

            foreach (var tournament in tournaments)
            {
                var teams = await db.Teams
                    .AsNoTracking()
                    .Where(team => team.TournamentId == tournament.Id)
                    .ToListAsync();

                if (teams.Count == 0)
                {
                    standingsByTournament[tournament.Id] = new List<StandingsRow>();
                    leadersByTournament[tournament.Id] = new TournamentLeaders();
                    continue;
                }

                var entries = new Dictionary<int, StandingsRow>();
                foreach (var team in teams)
                {
                    entries[team.Id] = new StandingsRow
                    {
                        TeamId = team.Id,
                        TeamName = team.Name,
                        Played = 0,
                        Wins = 0,
                        Draws = 0,
                        Losses = 0,
                        GoalsFor = 0,
                        GoalsAgainst = 0,
                        GoalDifference = 0,
                        Points = 0
                    };
                }

                var matches = await db.Matches
                    .AsNoTracking()
                    .Where(match => match.TournamentId == tournament.Id && match.Status == MatchStatus.Ended)
                    .ToListAsync();

                var goalEvents = await db.MatchEvents
                    .AsNoTracking()
                    .Where(matchEvent => matchEvent.Match.TournamentId == tournament.Id
                        && matchEvent.Match.Status == MatchStatus.Ended
                        && (matchEvent.EventType == MatchEventType.Goal || matchEvent.EventType == MatchEventType.PenaltyGoal))
                    .Select(matchEvent => new
                    {
                        matchEvent.GoalScorerId,
                        GoalScorerName = matchEvent.GoalScorer.FirstName + " " + matchEvent.GoalScorer.LastName,
                        GoalScorerTeamName = matchEvent.GoalScorer.Team.Name,
                        matchEvent.AssistedByPlayerId,
                        AssistedByPlayerName = matchEvent.AssistedByPlayer == null
                            ? null
                            : matchEvent.AssistedByPlayer.FirstName + " " + matchEvent.AssistedByPlayer.LastName,
                        AssistedByTeamName = matchEvent.AssistedByPlayer == null ? null : matchEvent.AssistedByPlayer.Team.Name
                    })
                    .ToListAsync();

                leadersByTournament[tournament.Id] = new TournamentLeaders
                {
                    GoalScorers = OrderLeaderboard(goalEvents
                        .GroupBy(goal => new { goal.GoalScorerId, goal.GoalScorerName, goal.GoalScorerTeamName })
                        .Select(group => new PlayerLeader(group.Key.GoalScorerTeamName, group.Key.GoalScorerName, group.Count()))),
                    AssistProviders = OrderLeaderboard(goalEvents
                        .Where(goal => goal.AssistedByPlayerId.HasValue && goal.AssistedByPlayerName is not null && goal.AssistedByTeamName is not null)
                        .GroupBy(goal => new { PlayerId = goal.AssistedByPlayerId!.Value, PlayerName = goal.AssistedByPlayerName!, TeamName = goal.AssistedByTeamName! })
                        .Select(group => new PlayerLeader(group.Key.TeamName, group.Key.PlayerName, group.Count())))
                };

                foreach (var match in matches)
                {
                    if (!entries.TryGetValue(match.HomeTeamId, out var homeRow) || !entries.TryGetValue(match.AwayTeamId, out var awayRow))
                    {
                        continue;
                    }

                    homeRow.Played++;
                    awayRow.Played++;
                    homeRow.GoalsFor += match.HomeScore;
                    homeRow.GoalsAgainst += match.AwayScore;
                    awayRow.GoalsFor += match.AwayScore;
                    awayRow.GoalsAgainst += match.HomeScore;

                    if (match.HomeScore > match.AwayScore)
                    {
                        homeRow.Wins++;
                        homeRow.Points += 3;
                        awayRow.Losses++;
                    }
                    else if (match.HomeScore < match.AwayScore)
                    {
                        awayRow.Wins++;
                        awayRow.Points += 3;
                        homeRow.Losses++;
                    }
                    else
                    {
                        homeRow.Draws++;
                        awayRow.Draws++;
                        homeRow.Points += 1;
                        awayRow.Points += 1;
                    }

                    homeRow.GoalDifference = homeRow.GoalsFor - homeRow.GoalsAgainst;
                    awayRow.GoalDifference = awayRow.GoalsFor - awayRow.GoalsAgainst;
                }

                var orderedRows = entries.Values
                    .OrderByDescending(row => row.Points)
                    .ThenByDescending(row => row.GoalDifference)
                    .ThenByDescending(row => row.GoalsFor)
                    .ThenBy(row => row.TeamName)
                    .ToList();

                for (var index = 0; index < orderedRows.Count; index++)
                {
                    orderedRows[index].Position = index + 1;
                }

                standingsByTournament[tournament.Id] = orderedRows;
            }
        }
        catch
        {
            errorMessage = "Please try again later.";
        }
    }

    private static List<PlayerLeader> OrderLeaderboard(IEnumerable<PlayerLeader> players)
    {
        return players
            .OrderByDescending(player => player.Count)
            .ThenBy(player => player.PlayerName)
            .ToList();
    }

    private sealed class TournamentLeaders
    {
        public List<PlayerLeader> GoalScorers { get; set; } = new();
        public List<PlayerLeader> AssistProviders { get; set; } = new();
    }

    private sealed record PlayerLeader(string TeamName, string PlayerName, int Count);

    private sealed class StandingsRow
    {
        public int TeamId { get; set; }
        public string TeamName { get; set; } = string.Empty;
        public int Position { get; set; }
        public int Played { get; set; }
        public int Wins { get; set; }
        public int Draws { get; set; }
        public int Losses { get; set; }
        public int GoalsFor { get; set; }
        public int GoalsAgainst { get; set; }
        public int GoalDifference { get; set; }
        public int Points { get; set; }
    }
}
