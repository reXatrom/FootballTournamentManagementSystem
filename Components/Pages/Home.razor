@page "/"
@rendermode InteractiveServer
@using FootballTournamentManagementSystem.Data
@using FootballTournamentManagementSystem.Models
@using Microsoft.EntityFrameworkCore
@inject ICurrentUserDbContextFactory DbFactory

<PageTitle>Dashboard</PageTitle>

@if (errorMessage is not null)
{
	<section class="empty-state"><h2>Unable to load dashboard</h2><p>@errorMessage</p></section>
}
else if (summary is null)
{
	<p>Loading dashboard...</p>
}
else
{
	<section class="dashboard-hero">
		<div>
			<p class="eyebrow">Football tournament management system</p>
			<h1>Keep every fixture moving.</h1>
			<p>One clear view of competitions, rosters, fixtures, and the moments that decide them.</p>
		</div>
		<div class="hero-ball" aria-hidden="true">&#9917;</div>
	</section>

	<section class="stat-grid" aria-label="System summary">
		<article class="stat-card stat-card-accent">
			<span class="stat-label">Tournaments</span>
			<strong>@summary.Tournaments</strong>
			<a href="/tournaments">Open calendar</a>
		</article>
		<article class="stat-card">
			<span class="stat-label">Teams</span>
			<strong>@summary.Teams</strong>
			<a href="/teams">View teams</a>
		</article>
		<article class="stat-card">
			<span class="stat-label">Players</span>
			<strong>@summary.Players</strong>
			<a href="/players">View players</a>
		</article>
		<article class="stat-card">
			<span class="stat-label">Matches</span>
			<strong>@summary.Matches</strong>
			<a href="/matches">View fixtures</a>
		</article>
	</section>

	<section class="dashboard-columns">
		<div class="dashboard-panel">
			<div class="panel-heading">
				<div>
					<p class="eyebrow">Next on the pitch</p>
					<h2>Upcoming fixtures</h2>
				</div>
				<a href="/matches">All matches</a>
			</div>
			@if (summary.UpcomingMatches.Count == 0)
			{
				<p class="panel-muted">No upcoming fixtures have been scheduled.</p>
			}
			else
			{
				@foreach (var match in summary.UpcomingMatches)
				{
					<div class="fixture-row">
						<div class="fixture-date">@match.MatchDate.ToString("MMM\ndd")</div>
						<div>
							<strong>@match.HomeTeam.Name <span>vs</span> @match.AwayTeam.Name</strong>
							<small>@match.Tournament.Name · @match.Location</small>
						</div>
						<span class="status-badge status-scheduled">Scheduled</span>
					</div>
				}
			}
				<div class="dashboard-subsection">
					<div class="panel-heading">
						<div>
							<p class="eyebrow">Final whistle</p>
							<h2>Recent results</h2>
						</div>
					</div>
					@if (summary.RecentResults.Count == 0)
					{
						<p class="panel-muted">No completed matches yet.</p>
					}
					else
					{
						@foreach (var match in summary.RecentResults)
						{
							<div class="fixture-row">
								<div class="fixture-date">@match.MatchDate.ToString("MMM\ndd")</div>
								<div>
									<strong>@match.HomeTeam.Name <span>vs</span> @match.AwayTeam.Name</strong>
									<small>@match.Tournament.Name · @match.HomeScore - @match.AwayScore</small>
								</div>
								<a href="/matches/@match.Id">Details</a>
							</div>
						}
					}
				</div>
		</div>

		<div class="dashboard-panel dashboard-panel-dark">
			<p class="eyebrow">Quick actions</p>
			<h2>Build the competition</h2>
			<p>Create the structure first, then let the match calendar tell the story.</p>
			<div class="quick-actions">
				<a href="/tournaments/create">New tournament</a>
				<a href="/teams/create">Add a team</a>
				<a href="/matches/create">Schedule a match</a>
				<a href="/standings">View standings</a>
			</div>
			<div class="dashboard-subsection">
				<div class="panel-heading">
					<div>
						<p class="eyebrow">Across the leagues</p>
						<h2>Current leaders</h2>
					</div>
					<a href="/standings">All standings</a>
				</div>
				@if (summary.CurrentLeaders.Count == 0)
				{
					<p>No goal events have been recorded yet.</p>
				}
				else
				{
					@foreach (var league in summary.CurrentLeaders)
					{
						<div class="leader-tournament">
							<strong>@league.TournamentName</strong>
							<p><span>Scorers:</span> @FormatLeaders(league.GoalScorers, "goals")</p>
							<p><span>Assists:</span> @FormatLeaders(league.AssistProviders, "assists")</p>
						</div>
					}
				}
			</div>
		</div>
	</section>
}

@code {
	private DashboardSummary? summary;
	private string? errorMessage;

	protected override async Task OnInitializedAsync()
	{
		try
		{
			await using var db = await DbFactory.CreateDbContextAsync();
			var goalEvents = await db.MatchEvents
				.AsNoTracking()
				.Where(item => item.Match.Status == MatchStatus.Ended
					&& (item.EventType == MatchEventType.Goal || item.EventType == MatchEventType.PenaltyGoal))
				.Select(item => new
				{
					TournamentId = item.Match.TournamentId,
					TournamentName = item.Match.Tournament.Name,
					TournamentStatus = item.Match.Tournament.Status,
					TournamentStartDate = item.Match.Tournament.StartDate,
					GoalScorerId = item.GoalScorerId,
					GoalScorerName = item.GoalScorer.FirstName + " " + item.GoalScorer.LastName,
					GoalScorerTeamName = item.GoalScorer.Team.Name,
					AssistedByPlayerId = item.AssistedByPlayerId,
					AssistedByPlayerName = item.AssistedByPlayer == null
						? null
						: item.AssistedByPlayer.FirstName + " " + item.AssistedByPlayer.LastName,
					AssistedByTeamName = item.AssistedByPlayer == null ? null : item.AssistedByPlayer.Team.Name
				})
				.ToListAsync();

			summary = new DashboardSummary
			{
				Tournaments = await db.Tournaments.CountAsync(),
				Teams = await db.Teams.CountAsync(),
				Players = await db.Players.CountAsync(),
				Matches = await db.Matches.CountAsync(),
				UpcomingMatches = await db.Matches
					.AsNoTracking()
					.Include(match => match.Tournament)
					.Include(match => match.HomeTeam)
					.Include(match => match.AwayTeam)
					.Where(match => match.Status == MatchStatus.Scheduled)
					.OrderBy(match => match.MatchDate)
					.Take(4)
					.ToListAsync(),
				RecentResults = await db.Matches
					.AsNoTracking()
					.Include(match => match.Tournament)
					.Include(match => match.HomeTeam)
					.Include(match => match.AwayTeam)
					.Where(match => match.Status == MatchStatus.Ended)
					.OrderByDescending(match => match.MatchDate)
					.ThenByDescending(match => match.MatchTime)
					.Take(4)
					.ToListAsync(),
				CurrentLeaders = goalEvents
					.GroupBy(item => new { item.TournamentId, item.TournamentName, item.TournamentStatus, item.TournamentStartDate })
					.Select(group =>
					{
						var scorers = group
							.GroupBy(item => new { item.GoalScorerId, item.GoalScorerName, item.GoalScorerTeamName })
							.Select(playerGroup => new LeaderboardPlayer(playerGroup.Key.GoalScorerName, playerGroup.Key.GoalScorerTeamName, playerGroup.Count()))
							.ToList();
						var assists = group
							.Where(item => item.AssistedByPlayerId.HasValue && item.AssistedByPlayerName is not null && item.AssistedByTeamName is not null)
							.GroupBy(item => new { PlayerId = item.AssistedByPlayerId!.Value, PlayerName = item.AssistedByPlayerName!, TeamName = item.AssistedByTeamName! })
							.Select(playerGroup => new LeaderboardPlayer(playerGroup.Key.PlayerName, playerGroup.Key.TeamName, playerGroup.Count()))
							.ToList();

						return new TournamentLeaderSummary
						{
							TournamentName = group.Key.TournamentName,
							TournamentStatus = group.Key.TournamentStatus,
							TournamentStartDate = group.Key.TournamentStartDate,
							GoalScorers = GetLeaders(scorers),
							AssistProviders = GetLeaders(assists)
						};
					})
					.OrderBy(item => item.TournamentStatus == TournamentStatus.Ongoing ? 0 : 1)
					.ThenByDescending(item => item.TournamentStartDate)
					.Take(3)
					.ToList()
			};
		}
		catch
		{
			errorMessage = "Please try again later.";
		}
	}

	private static List<LeaderboardPlayer> GetLeaders(IEnumerable<LeaderboardPlayer> players)
	{
		var orderedPlayers = players
			.OrderByDescending(player => player.Count)
			.ThenBy(player => player.PlayerName)
			.ToList();

		return orderedPlayers.Count == 0
			? orderedPlayers
			: orderedPlayers.Where(player => player.Count == orderedPlayers[0].Count).ToList();
	}

	private static string FormatLeaders(IEnumerable<LeaderboardPlayer> players, string unit)
	{
		var formattedPlayers = players.Select(player => $"{player.PlayerName} ({player.TeamName}), {player.Count} {unit}");
		var result = string.Join("; ", formattedPlayers);
		return result.Length == 0 ? $"No {unit} recorded." : result;
	}

	private sealed class DashboardSummary
	{
		public int Tournaments { get; init; }
		public int Teams { get; init; }
		public int Players { get; init; }
		public int Matches { get; init; }
		public List<Match> UpcomingMatches { get; init; } = new();
		public List<Match> RecentResults { get; init; } = new();
		public List<TournamentLeaderSummary> CurrentLeaders { get; init; } = new();
	}

	private sealed class TournamentLeaderSummary
	{
		public string TournamentName { get; init; } = string.Empty;
		public TournamentStatus TournamentStatus { get; init; }
		public DateTime TournamentStartDate { get; init; }
		public List<LeaderboardPlayer> GoalScorers { get; init; } = new();
		public List<LeaderboardPlayer> AssistProviders { get; init; } = new();
	}

	private sealed record LeaderboardPlayer(string PlayerName, string TeamName, int Count);
}
