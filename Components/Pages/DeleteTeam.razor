@page "/teams/delete/{Id:int}"
@rendermode InteractiveServer
@using FootballTournamentManagementSystem.Data
@using FootballTournamentManagementSystem.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject ICurrentUserDbContextFactory DbFactory
@inject IRecordAccessService RecordAccessService
@inject NavigationManager Navigation

<PageTitle>Delete Team</PageTitle>

@if (isLoading)
{
    <p>Loading team...</p>
}
else if (loadError is not null)
{
    <section class="empty-state"><h2>Unable to load team</h2><p>@loadError</p><a href="/teams">Back to teams</a></section>
}
else if (accessDenied)
{
    <section class="empty-state"><h2>Access denied</h2><p>You don't have permission to modify this record.</p></section>
}
else if (team is null)
{
    <section class="empty-state"><h2>Team not found</h2><a href="/teams">Back to teams</a></section>
}
else
{
    <div class="form-page">
        <p class="eyebrow">Team management</p>
        <h1 class="page-title">Delete team</h1>
        <p class="page-subtitle">Review this action before permanently removing the team.</p>
        <section class="confirmation-panel">
            <h2>@team.Name</h2>
            <p>@team.Tournament.Name</p>
            @if (hasRelatedData)
            {
                <p class="validation-message">@(deleteError ?? "This team cannot be deleted because it has players or matches. Remove those records first.")</p>
            }
            else
            {
                <p>This team has no players or matches and can be safely deleted.</p>
                <button class="btn btn-danger" @onclick="DeleteAsync">Delete team</button>
            }
            @if (!string.IsNullOrWhiteSpace(deleteError) && !hasRelatedData)
            {
                <p class="validation-message">@deleteError</p>
            }
            <a class="btn btn-secondary" href="/teams">Cancel</a>
        </section>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private Team? team;
    private bool hasRelatedData;
    private bool isLoading = true;
    private string? loadError;
    private string? deleteError;
    private bool accessDenied;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var access = await RecordAccessService.CheckAsync<Team>(Id);
            if (access == RecordAccessDecision.Forbidden)
            {
                accessDenied = true;
                return;
            }
            if (access == RecordAccessDecision.NotFound)
            {
                return;
            }

            await using var db = await DbFactory.CreateDbContextAsync();
            team = await db.Teams.AsNoTracking().Include(item => item.Tournament).SingleOrDefaultAsync(item => item.Id == Id);
            if (team is not null)
            {
                hasRelatedData = await db.Players.AnyAsync(player => player.TeamId == Id)
                    || await db.Matches.AnyAsync(match => match.HomeTeamId == Id || match.AwayTeamId == Id);
            }
        }
        catch
        {
            loadError = "Please try again later.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task DeleteAsync()
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var teamToDelete = await db.Teams.FindAsync(Id);
            if (teamToDelete is null)
            {
                Navigation.NavigateTo("/teams");
                return;
            }

            var hasPlayers = await db.Players.AnyAsync(player => player.TeamId == Id);
            var hasMatches = await db.Matches.AnyAsync(match => match.HomeTeamId == Id || match.AwayTeamId == Id);
            if (hasPlayers || hasMatches)
            {
                hasRelatedData = true;
                return;
            }

            db.Teams.Remove(teamToDelete);
            await db.SaveChangesAsync();
            Navigation.NavigateTo("/teams?saved=1");
        }
        catch (RecordAccessDeniedException exception)
        {
            deleteError = exception.Message;
        }
        catch (DbUpdateConcurrencyException)
        {
            deleteError = "This team was changed by someone else. Reload before deleting.";
        }
        catch (DbUpdateException)
        {
            hasRelatedData = true;
            deleteError = "Cannot delete this team because it still has players or matches.";
        }
        catch
        {
            deleteError = "Unable to delete the team. Please try again.";
        }
    }
}
