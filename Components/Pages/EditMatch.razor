@page "/matches/edit/{Id:int}"
@page "/matches/{Id:int}/edit"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using FootballTournamentManagementSystem.Data
@using FootballTournamentManagementSystem.Models
@using FootballTournamentManagementSystem.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@inject ICurrentUserDbContextFactory DbFactory
@inject IRecordAccessService RecordAccessService
@inject NavigationManager Navigation

<PageTitle>Edit Match</PageTitle>

@if (isLoading)
{
    <p>Loading match...</p>
}
else if (loadError is not null)
{
    <section class="empty-state"><h2>Unable to load match</h2><p>@loadError</p><a href="/matches">Back to matches</a></section>
}
else if (accessDenied)
{
    <section class="empty-state"><h2>Access denied</h2><p>You don't have permission to modify this record.</p></section>
}
else if (model is null)
{
    <section class="empty-state"><h2>Match not found</h2><a href="/matches">Back to matches</a></section>
}
else
{
    <div class="form-page">
        <p class="eyebrow">Fixture management</p>
        <h1 class="page-title">Edit match</h1>
        <p class="page-subtitle">Update fixture details, status, and score.</p>
        <EditForm Model="model" OnValidSubmit="SaveMatch" class="tournament-form">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <div class="form-grid">
                <div class="form-field form-field-wide">
                    <label for="tournament">Tournament</label>
                    <InputSelect id="tournament" @bind-Value="model.TournamentId">
                        @foreach (var tournament in tournaments)
                        {
                            <option value="@tournament.Id">@tournament.Name</option>
                        }
                    </InputSelect>
                </div>
                <div class="form-field">
                    <label for="home-team">Home team</label>
                    <InputSelect id="home-team" @bind-Value="model.HomeTeamId">
                        @foreach (var team in teams)
                        {
                            <option value="@team.Id">@team.Name - @team.Tournament</option>
                        }
                    </InputSelect>
                </div>
                <div class="form-field">
                    <label for="away-team">Away team</label>
                    <InputSelect id="away-team" @bind-Value="model.AwayTeamId">
                        @foreach (var team in teams)
                        {
                            <option value="@team.Id">@team.Name - @team.Tournament</option>
                        }
                    </InputSelect>
                </div>
                <div class="form-field">
                    <label for="date">Match date</label>
                    <InputDate id="date" @bind-Value="model.MatchDate" />
                </div>
                <div class="form-field">
                    <label for="location">Location</label>
                    <InputText id="location" @bind-Value="model.Location" />
                    <ValidationMessage For="@(() => model.Location)" />
                </div>
                <div class="form-field">
                    <label for="status">Status</label>
                    <InputSelect id="status" @bind-Value="model.Status">
                        @foreach (var status in Enum.GetValues<MatchStatus>())
                        {
                            <option value="@status">@status</option>
                        }
                    </InputSelect>
                </div>
                <div class="form-field form-field-wide">
                    <label>Score</label>
                    <p class="form-static-value">@model.HomeScore - @model.AwayScore · Calculated from goal events</p>
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <p class="validation-message">@errorMessage</p>
            }
            <div class="form-actions">
                <a class="btn btn-secondary" href="/matches">Cancel</a>
                <button class="btn btn-primary" type="submit">Save changes</button>
            </div>
        </EditForm>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }
    private MatchInput? model;
    private List<Tournament> tournaments = new();
    private List<TeamOption> teams = new();
    private string? errorMessage;
    private string? loadError;
    private bool isLoading = true;
    private bool accessDenied;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var access = await RecordAccessService.CheckAsync<Match>(Id);
            if (access == RecordAccessDecision.Forbidden)
            {
                accessDenied = true;
                return;
            }
            if (access == RecordAccessDecision.NotFound)
            {
                return;
            }

            await using var db = await DbFactory.CreateDbContextAsync();
            tournaments = await db.Tournaments.AsNoTracking().OrderBy(item => item.Name).ToListAsync();
            teams = await db.Teams.AsNoTracking().OrderBy(item => item.Name)
                .Select(item => new TeamOption { Id = item.Id, Name = item.Name, Tournament = item.Tournament.Name }).ToListAsync();
            var match = await db.Matches.AsNoTracking().SingleOrDefaultAsync(item => item.Id == Id);
            if (match is not null)
            {
                var scores = await MatchScoreCalculator.CalculateAsync(db, new[] { match.Id });
                model = new MatchInput
                {
                    TournamentId = match.TournamentId, HomeTeamId = match.HomeTeamId, AwayTeamId = match.AwayTeamId,
                    MatchDate = match.MatchDate, Location = match.Location, Status = match.Status,
                    HomeScore = scores.TryGetValue(match.Id, out var score) ? score.HomeScore : match.HomeScore,
                    AwayScore = scores.TryGetValue(match.Id, out score) ? score.AwayScore : match.AwayScore
                };
            }
        }
        catch
        {
            loadError = "Please try again later.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SaveMatch()
    {
        if (model is null) return;
        if (model.HomeTeamId == model.AwayTeamId)
        {
            errorMessage = "Home and away teams must be different.";
            return;
        }

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var validTeams = await db.Teams.CountAsync(team => team.TournamentId == model.TournamentId
                && (team.Id == model.HomeTeamId || team.Id == model.AwayTeamId));
            if (validTeams != 2)
            {
                errorMessage = "Both selected teams must belong to the selected tournament.";
                return;
            }

            var match = await db.Matches.FindAsync(Id);
            if (match is null)
            {
                errorMessage = "This match no longer exists.";
                return;
            }

            if (model.Status == MatchStatus.Ended)
            {
                var teamOverrides = new Dictionary<int, (int HomeTeamId, int AwayTeamId)>
                {
                    [Id] = (model.HomeTeamId, model.AwayTeamId)
                };
                var scores = await MatchScoreCalculator.CalculateAsync(db, new[] { Id }, teamOverrides: teamOverrides);
                if (!scores.TryGetValue(Id, out var score) || score.ValidationError is not null)
                {
                    errorMessage = score?.ValidationError ?? "The score could not be calculated from the recorded goal events.";
                    return;
                }

                model.HomeScore = score.HomeScore;
                model.AwayScore = score.AwayScore;
            }

            match.TournamentId = model.TournamentId; match.HomeTeamId = model.HomeTeamId; match.AwayTeamId = model.AwayTeamId;
            match.MatchDate = model.MatchDate; match.Location = model.Location; match.Status = model.Status;
            match.HomeScore = model.HomeScore; match.AwayScore = model.AwayScore;
            await db.SaveChangesAsync();
            Navigation.NavigateTo("/matches?saved=1");
        }
        catch (RecordAccessDeniedException exception)
        {
            errorMessage = exception.Message;
        }
        catch (DbUpdateConcurrencyException)
        {
            errorMessage = "This match was changed by someone else. Reload the page before saving again.";
        }
        catch (DbUpdateException)
        {
            errorMessage = "Unable to save the match. Confirm the tournament and both teams still exist.";
        }
        catch
        {
            errorMessage = "Unable to save the match. Please try again.";
        }

    }

    private sealed class MatchInput
    {
        [Required, Range(1, int.MaxValue)] public int TournamentId { get; set; }
        [Required, Range(1, int.MaxValue)] public int HomeTeamId { get; set; }
        [Required, Range(1, int.MaxValue)] public int AwayTeamId { get; set; }
        [Required] public DateTime MatchDate { get; set; }
        [StringLength(200)] public string? Location { get; set; }
        public int HomeScore { get; set; }
        public int AwayScore { get; set; }
        public MatchStatus Status { get; set; }
    }

    private sealed class TeamOption
    {
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string Tournament { get; set; } = string.Empty;
    }
}
