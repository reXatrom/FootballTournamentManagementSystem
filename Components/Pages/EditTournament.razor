@page "/tournaments/edit/{Id:int}"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using FootballTournamentManagementSystem.Data
@using FootballTournamentManagementSystem.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@inject ICurrentUserDbContextFactory DbFactory
@inject IRecordAccessService RecordAccessService
@inject NavigationManager Navigation

<PageTitle>Edit Tournament</PageTitle>

@if (isLoading)
{
    <p>Loading tournament...</p>
}
else if (loadError is not null)
{
    <section class="empty-state"><h2>Unable to load tournament</h2><p>@loadError</p><a href="/tournaments">Back to tournaments</a></section>
}
else if (accessDenied)
{
    <section class="empty-state"><h2>Access denied</h2><p>You don't have permission to modify this record.</p></section>
}
else if (model is null)
{
    <section class="empty-state"><h2>Tournament not found</h2><a href="/tournaments">Back to tournaments</a></section>
}
else
{
    <div class="form-page">
        <p class="eyebrow">Tournament management</p>
        <h1 class="page-title">Edit tournament</h1>
        <p class="page-subtitle">Update the competition details.</p>

        <EditForm Model="model" OnValidSubmit="SaveTournament" class="tournament-form">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="form-grid">
                <div class="form-field form-field-wide">
                    <label for="name">Tournament name</label>
                    <InputText id="name" @bind-Value="model.Name" />
                    <ValidationMessage For="@(() => model.Name)" />
                </div>
                <div class="form-field">
                    <label for="location">Location</label>
                    <InputText id="location" @bind-Value="model.Location" />
                    <ValidationMessage For="@(() => model.Location)" />
                </div>
                <div class="form-field">
                    <label for="status">Status</label>
                    <InputSelect id="status" @bind-Value="model.Status">
                        @foreach (var status in Enum.GetValues<TournamentStatus>())
                        {
                            <option value="@status">@status</option>
                        }
                    </InputSelect>
                </div>
                <div class="form-field">
                    <label for="start-date">Start date</label>
                    <InputDate id="start-date" @bind-Value="model.StartDate" />
                    <ValidationMessage For="@(() => model.StartDate)" />
                </div>
                <div class="form-field">
                    <label for="end-date">End date</label>
                    <InputDate id="end-date" @bind-Value="model.EndDate" />
                    <ValidationMessage For="@(() => model.EndDate)" />
                </div>
                <div class="form-field form-field-wide">
                    <label for="description">Description</label>
                    <InputTextArea id="description" @bind-Value="model.Description" rows="5" />
                    <ValidationMessage For="@(() => model.Description)" />
                </div>
            </div>

            <div class="form-actions">
                <a class="btn btn-secondary" href="/tournaments">Cancel</a>
                <button class="btn btn-primary" type="submit">Save changes</button>
            </div>
            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <p class="validation-message">@errorMessage</p>
            }
        </EditForm>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private TournamentInput? model;
    private string? errorMessage;
    private string? loadError;
    private bool isLoading = true;
    private bool accessDenied;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var access = await RecordAccessService.CheckAsync<Tournament>(Id);
            if (access == RecordAccessDecision.Forbidden)
            {
                accessDenied = true;
                return;
            }
            if (access == RecordAccessDecision.NotFound)
            {
                return;
            }

            await using var db = await DbFactory.CreateDbContextAsync();
            var tournament = await db.Tournaments.AsNoTracking().SingleOrDefaultAsync(item => item.Id == Id);
            if (tournament is not null)
            {
                model = new TournamentInput
                {
                    Name = tournament.Name,
                    Description = tournament.Description,
                    Location = tournament.Location,
                    StartDate = tournament.StartDate,
                    EndDate = tournament.EndDate,
                    Status = tournament.Status
                };
            }
        }
        catch
        {
            loadError = "Please try again later.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SaveTournament()
    {
        if (model is null || model.EndDate < model.StartDate)
        {
            errorMessage = "The end date must be on or after the start date.";
            return;
        }

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var tournament = await db.Tournaments.FindAsync(Id);
            if (tournament is null)
            {
                errorMessage = "This tournament no longer exists.";
                return;
            }

            tournament.Name = model.Name;
            tournament.Description = model.Description;
            tournament.Location = model.Location;
            tournament.StartDate = model.StartDate;
            tournament.EndDate = model.EndDate;
            tournament.Status = model.Status;

            await db.SaveChangesAsync();
            Navigation.NavigateTo("/tournaments?saved=1");
        }
        catch (RecordAccessDeniedException exception)
        {
            errorMessage = exception.Message;
        }
        catch (DbUpdateConcurrencyException)
        {
            errorMessage = "This tournament was changed by someone else. Reload the page before saving again.";
        }
        catch
        {
            errorMessage = "Unable to save the tournament. Please try again.";
        }
    }

    private sealed class TournamentInput
    {
        [Required, StringLength(200)]
        public string Name { get; set; } = string.Empty;

        [Required, StringLength(1000)]
        public string Description { get; set; } = string.Empty;

        [Required, StringLength(200)]
        public string Location { get; set; } = string.Empty;

        [Required]
        public DateTime StartDate { get; set; }

        [Required]
        public DateTime EndDate { get; set; }

        [Required]
        public TournamentStatus Status { get; set; }
    }
}
