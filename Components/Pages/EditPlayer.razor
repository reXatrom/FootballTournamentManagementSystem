@page "/players/edit/{Id:int}"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Administrator,Tournament Manager")]
@using System.ComponentModel.DataAnnotations
@using FootballTournamentManagementSystem.Data
@using FootballTournamentManagementSystem.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager Navigation

<PageTitle>Edit Player</PageTitle>

@if (model is null)
{
    <p>Loading player...</p>
}
else
{
    <div class="form-page">
        <p class="eyebrow">Roster management</p>
        <h1 class="page-title">Edit player</h1>
        <p class="page-subtitle">Update the player profile and team assignment.</p>
        <EditForm Model="model" OnValidSubmit="SavePlayer" class="tournament-form">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <div class="form-grid">
                <div class="form-field">
                    <label for="first-name">First name</label>
                    <InputText id="first-name" @bind-Value="model.FirstName" />
                    <ValidationMessage For="@(() => model.FirstName)" />
                </div>
                <div class="form-field">
                    <label for="last-name">Last name</label>
                    <InputText id="last-name" @bind-Value="model.LastName" />
                    <ValidationMessage For="@(() => model.LastName)" />
                </div>
                <div class="form-field">
                    <label for="team">Team</label>
                    <InputSelect id="team" @bind-Value="model.TeamId">
                        @foreach (var team in teams)
                        {
                            <option value="@team.Id">@team.Name - @team.Tournament</option>
                        }
                    </InputSelect>
                </div>
                <div class="form-field">
                    <label for="position">Position</label>
                    <InputSelect id="position" @bind-Value="model.Position">
                        @foreach (var position in Enum.GetValues<PlayerPosition>())
                        {
                            <option value="@position">@position</option>
                        }
                    </InputSelect>
                </div>
                <div class="form-field">
                    <label for="jersey-number">Jersey number</label>
                    <InputNumber id="jersey-number" @bind-Value="model.JerseyNumber" />
                    <ValidationMessage For="@(() => model.JerseyNumber)" />
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <p class="validation-message">@errorMessage</p>
            }
            <div class="form-actions">
                <a class="btn btn-secondary" href="/players">Cancel</a>
                <button class="btn btn-primary" type="submit">Save changes</button>
            </div>
        </EditForm>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private PlayerInput? model;
    private List<TeamOption> teams = new();
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        teams = await db.Teams.AsNoTracking().Include(team => team.Tournament).OrderBy(team => team.Name)
            .Select(team => new TeamOption { Id = team.Id, Name = team.Name, Tournament = team.Tournament.Name })
            .ToListAsync();
        var player = await db.Players.AsNoTracking().SingleOrDefaultAsync(item => item.Id == Id);
        if (player is not null)
        {
            model = new PlayerInput
            {
                FirstName = player.FirstName,
                LastName = player.LastName,
                Position = player.Position,
                JerseyNumber = player.JerseyNumber,
                TeamId = player.TeamId
            };
        }
    }

    private async Task SavePlayer()
    {
        if (model is null)
        {
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        var duplicateExists = await db.Players.AnyAsync(player => player.Id != Id
            && player.TeamId == model.TeamId && player.JerseyNumber == model.JerseyNumber);
        if (duplicateExists)
        {
            errorMessage = "That jersey number is already assigned on the selected team.";
            return;
        }

        var playerToUpdate = await db.Players.FindAsync(Id);
        if (playerToUpdate is null)
        {
            Navigation.NavigateTo("/players");
            return;
        }

        playerToUpdate.FirstName = model.FirstName;
        playerToUpdate.LastName = model.LastName;
        playerToUpdate.Position = model.Position;
        playerToUpdate.JerseyNumber = model.JerseyNumber;
        playerToUpdate.TeamId = model.TeamId;
        await db.SaveChangesAsync();
        Navigation.NavigateTo("/players");
    }

    private sealed class PlayerInput
    {
        [Required, StringLength(100)] public string FirstName { get; set; } = string.Empty;
        [Required, StringLength(100)] public string LastName { get; set; } = string.Empty;
        [Required] public PlayerPosition Position { get; set; }
        [Range(1, 99)] public int JerseyNumber { get; set; }
        [Required] public int TeamId { get; set; }
    }

    private sealed class TeamOption
    {
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string Tournament { get; set; } = string.Empty;
    }
}
