@page "/teams/create"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Administrator,Tournament Manager")]
@using System.ComponentModel.DataAnnotations
@using FootballTournamentManagementSystem.Data
@using FootballTournamentManagementSystem.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager Navigation

<PageTitle>Add Team</PageTitle>

@if (tournaments is null)
{
    <p>Loading tournaments...</p>
}
else if (tournaments.Count == 0)
{
    <section class="empty-state">
        <h2>Create a tournament first</h2>
        <p>A team must belong to a tournament.</p>
        <a class="btn btn-primary" href="/tournaments/create">Create tournament</a>
    </section>
}
else
{
    <div class="form-page">
        <p class="eyebrow">Team management</p>
        <h1 class="page-title">Add team</h1>
        <p class="page-subtitle">Register a team for an existing tournament.</p>

        <EditForm Model="model" OnValidSubmit="SaveTeam" class="tournament-form">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="form-grid">
                <div class="form-field form-field-wide">
                    <label for="name">Team name</label>
                    <InputText id="name" @bind-Value="model.Name" />
                    <ValidationMessage For="@(() => model.Name)" />
                </div>
                <div class="form-field">
                    <label for="tournament">Tournament</label>
                    <InputSelect id="tournament" @bind-Value="model.TournamentId">
                        @foreach (var tournament in tournaments)
                        {
                            <option value="@tournament.Id">@tournament.Name</option>
                        }
                    </InputSelect>
                </div>
                <div class="form-field">
                    <label for="logo">Logo URL</label>
                    <InputText id="logo" @bind-Value="model.LogoUrl" />
                    <ValidationMessage For="@(() => model.LogoUrl)" />
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <p class="validation-message">@errorMessage</p>
            }

            <div class="form-actions">
                <a class="btn btn-secondary" href="/teams">Cancel</a>
                <button class="btn btn-primary" type="submit">Add team</button>
            </div>
        </EditForm>
    </div>
}

@code {
    private List<Tournament>? tournaments;
    private string? errorMessage;
    private readonly TeamInput model = new();

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        tournaments = await db.Tournaments
            .AsNoTracking()
            .OrderBy(tournament => tournament.StartDate)
            .ToListAsync();

        if (tournaments.Count > 0)
        {
            model.TournamentId = tournaments[0].Id;
        }
    }

    private async Task SaveTeam()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var duplicateExists = await db.Teams.AnyAsync(team =>
            team.TournamentId == model.TournamentId && team.Name == model.Name);

        if (duplicateExists)
        {
            errorMessage = "A team with this name already exists in the selected tournament.";
            return;
        }

        db.Teams.Add(new Team
        {
            Name = model.Name,
            LogoUrl = string.IsNullOrWhiteSpace(model.LogoUrl) ? null : model.LogoUrl,
            TournamentId = model.TournamentId
        });

        await db.SaveChangesAsync();
        Navigation.NavigateTo("/teams");
    }

    private sealed class TeamInput
    {
        [Required, StringLength(150)]
        public string Name { get; set; } = string.Empty;

        [Required]
        public int TournamentId { get; set; }

        [Url, StringLength(500)]
        public string? LogoUrl { get; set; }
    }
}
