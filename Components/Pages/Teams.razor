@page "/teams"
@rendermode InteractiveServer
@using FootballTournamentManagementSystem.Data
@using FootballTournamentManagementSystem.Models
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@inject ICurrentUserDbContextFactory DbFactory
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Teams</PageTitle>

@if (Saved == "1")
{
    <p class="panel-muted">Changes saved.</p>
}

<div class="page-heading">
    <div>
        <p class="eyebrow">Tournament roster</p>
        <h1 class="page-title">Teams</h1>
        <p class="page-subtitle">View the teams registered for each competition.</p>
    </div>
    <a class="btn btn-primary" href="/teams/create">Add team</a>
</div>

@if (errorMessage is not null)
{
    <section class="empty-state"><h2>Unable to load teams</h2><p>@errorMessage</p></section>
}
else if (teams is null)
{
    <p>Loading teams...</p>
}
else if (teams.Count == 0)
{
    <section class="empty-state">
        <h2>No teams yet</h2>
        <p>Create a tournament team to begin building the competition roster.</p>
    </section>
}
else
{
    <div class="league-list">
        @foreach (var leagueGroup in teams.GroupBy(team => team.TournamentId))
        {
            var league = leagueGroup.First().Tournament;
            <section class="league-section">
                <div class="league-heading">
                    <div>
                        <p class="eyebrow">League</p>
                        <h2>@league.Name</h2>
                        <p>@league.Location · @leagueGroup.Count() teams</p>
                    </div>
                    <span class="league-status">@league.Status</span>
                </div>

                <div class="team-grid">
                    @foreach (var team in leagueGroup.OrderBy(item => item.Name))
                    {
                        <article class="team-card">
                            <div class="team-avatar-wrapper">
                                @if (!string.IsNullOrWhiteSpace(team.LogoUrl) && !failedLogoTeamIds.Contains(team.Id))
                                {
                                    <img src="@team.LogoUrl" alt="@($"{team.Name} club logo")" @onerror="@(() => OnLogoError(team.Id))" />
                                }
                                else
                                {
                                    <span aria-hidden="true">@(string.IsNullOrWhiteSpace(team.Name) ? "?" : team.Name[..1].ToUpperInvariant())</span>
                                }
                            </div>
                            <div>
                                <h3>@team.Name</h3>
                                <p>@team.Players.Count player(s)</p>
                                <p class="panel-muted">Created by @team.CreatedByUser.FullName · @team.CreatedAt.ToLocalTime().ToString("g")</p>
                                <div class="card-actions">
                                    <a href="/teams/@team.Id">Details</a>
                                    @if (CanManage(team))
                                    {
                                            <a href="/teams/edit/@team.Id">Edit</a>
                                            <a href="/teams/delete/@team.Id">Delete</a>
                                    }
                                </div>
                            </div>
                        </article>
                    }
                </div>
            </section>
        }
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "saved")]
    public string? Saved { get; set; }

    private List<Team>? teams;
    private string? errorMessage;
    private string? currentUserId;
    private bool isAdmin;
    private readonly HashSet<int> failedLogoTeamIds = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
            currentUserId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            isAdmin = user.IsInRole("Admin");
            await using var db = await DbFactory.CreateDbContextAsync();
            teams = await db.Teams
                .AsNoTracking()
                .Include(team => team.Tournament)
                .Include(team => team.Players)
                .Include(team => team.CreatedByUser)
                .OrderBy(team => team.Tournament.Name)
                .ThenBy(team => team.Name)
                .ToListAsync();
        }
        catch
        {
            errorMessage = "Please try again later.";
        }
    }

    private bool CanManage(IOwnedRecord record) => isAdmin || record.CreatedByUserId == currentUserId;

    private void OnLogoError(int teamId) => failedLogoTeamIds.Add(teamId);
}
