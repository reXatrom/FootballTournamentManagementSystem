@page "/teams"
@rendermode InteractiveServer
@using FootballTournamentManagementSystem.Data
@using FootballTournamentManagementSystem.Models
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<ApplicationDbContext> DbFactory

<PageTitle>Teams</PageTitle>

<div class="page-heading">
    <div>
        <p class="eyebrow">Tournament roster</p>
        <h1 class="page-title">Teams</h1>
        <p class="page-subtitle">View the teams registered for each competition.</p>
    </div>
    <AuthorizeView Roles="Administrator,Tournament Manager">
        <Authorized>
            <a class="btn btn-primary" href="/teams/create">Add team</a>
        </Authorized>
    </AuthorizeView>
</div>

@if (teams is null)
{
    <p>Loading teams...</p>
}
else if (teams.Count == 0)
{
    <section class="empty-state">
        <h2>No teams yet</h2>
        <p>Create a tournament team to begin building the competition roster.</p>
    </section>
}
else
{
    <div class="team-grid">
        @foreach (var team in teams)
        {
            <article class="team-card">
                <div class="team-mark" aria-hidden="true">@team.Name[..1].ToUpperInvariant()</div>
                <div>
                    <p class="eyebrow">@team.Tournament.Name</p>
                    <h2>@team.Name</h2>
                    <p>@team.Players.Count player(s)</p>
                    <AuthorizeView Roles="Administrator,Tournament Manager">
                        <Authorized>
                            <div class="card-actions">
                                <a href="/teams/edit/@team.Id">Edit</a>
                                <a href="/teams/delete/@team.Id">Delete</a>
                            </div>
                        </Authorized>
                    </AuthorizeView>
                </div>
            </article>
        }
    </div>
}

@code {
    private List<Team>? teams;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        teams = await db.Teams
            .AsNoTracking()
            .Include(team => team.Tournament)
            .Include(team => team.Players)
            .OrderBy(team => team.Tournament.Name)
            .ThenBy(team => team.Name)
            .ToListAsync();
    }
}
