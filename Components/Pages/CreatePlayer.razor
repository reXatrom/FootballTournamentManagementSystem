@page "/players/create"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using FootballTournamentManagementSystem.Data
@using FootballTournamentManagementSystem.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@using Microsoft.Data.SqlClient
@inject ICurrentUserDbContextFactory DbFactory
@inject NavigationManager Navigation
@inject ILogger<CreatePlayer> Logger

<PageTitle>Add Player</PageTitle>

@if (loadError is not null)
{
    <section class="empty-state"><h2>Unable to load teams</h2><p>@loadError</p></section>
}
else if (teams is null)
{
    <p>Loading teams...</p>
}
else if (teams.Count == 0)
{
    <section class="empty-state">
        <h2>Create a team first</h2>
        <p>A player must belong to a team.</p>
        <a class="btn btn-primary" href="/teams/create">Create team</a>
    </section>
}
else
{
    <div class="form-page">
        <p class="eyebrow">Roster management</p>
        <h1 class="page-title">Add player</h1>
        <p class="page-subtitle">Register a player and assign a position and jersey number.</p>

        <EditForm Model="model" OnValidSubmit="SavePlayer" class="tournament-form">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="form-grid">
                <div class="form-field">
                    <label for="first-name">First name</label>
                    <InputText id="first-name" @bind-Value="model.FirstName" />
                    <ValidationMessage For="@(() => model.FirstName)" />
                </div>
                <div class="form-field">
                    <label for="last-name">Last name</label>
                    <InputText id="last-name" @bind-Value="model.LastName" />
                    <ValidationMessage For="@(() => model.LastName)" />
                </div>
                <div class="form-field">
                    <label for="team">Team</label>
                    <InputSelect id="team" @bind-Value="model.TeamId">
                        @foreach (var team in teams)
                        {
                            <option value="@team.Id">@team.Name - @team.Tournament</option>
                        }
                    </InputSelect>
                </div>
                <div class="form-field">
                    <label for="position">Position</label>
                    <InputSelect id="position" @bind-Value="model.Position">
                        @foreach (var position in Enum.GetValues<PlayerPosition>())
                        {
                            <option value="@position">@position</option>
                        }
                    </InputSelect>
                </div>
                <div class="form-field">
                    <label for="jersey-number">Jersey number</label>
                    <InputNumber id="jersey-number" @bind-Value="model.JerseyNumber" />
                    <ValidationMessage For="@(() => model.JerseyNumber)" />
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <p class="validation-message">@errorMessage</p>
            }

            <div class="form-actions">
                <a class="btn btn-secondary" href="/players">Cancel</a>
                <button class="btn btn-primary" type="submit">Add player</button>
            </div>
        </EditForm>
    </div>
}

@code {
    private List<TeamOption>? teams;
    private string? errorMessage;
    private string? loadError;
    private readonly PlayerInput model = new()
    {
        Position = PlayerPosition.Midfielder,
        JerseyNumber = 1
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            teams = await db.Teams
                .AsNoTracking()
                .OrderBy(team => team.Name)
                .Select(team => new TeamOption
                {
                    Id = team.Id,
                    Name = team.Name,
                    Tournament = team.Tournament.Name
                })
                .ToListAsync();

            if (teams.Count > 0)
            {
                model.TeamId = teams[0].Id;
            }
        }
        catch
        {
            loadError = "Please try again later.";
        }
    }

    private async Task SavePlayer()
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var duplicateExists = await db.Players.IgnoreQueryFilters().AnyAsync(player =>
                player.TeamId == model.TeamId && player.JerseyNumber == model.JerseyNumber);

            if (duplicateExists)
            {
                errorMessage = "That jersey number is already assigned on the selected team.";
                return;
            }

            db.Players.Add(new Player
            {
                FirstName = model.FirstName,
                LastName = model.LastName,
                Position = model.Position,
                JerseyNumber = model.JerseyNumber,
                TeamId = model.TeamId
            });

            await db.SaveChangesAsync();
            Navigation.NavigateTo("/players?saved=1");
        }
        catch (RecordAccessDeniedException exception)
        {
            errorMessage = exception.Message;
        }
        catch (DbUpdateException exception)
        {
            Logger.LogError(exception, "Database error while creating a player.");
            errorMessage = GetSaveErrorMessage(exception);
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Unexpected error while creating a player.");
            errorMessage = "Unable to save the player. Please try again.";
        }
    }

    private static string GetSaveErrorMessage(DbUpdateException exception)
    {
        return exception.GetBaseException() is SqlException sqlException
            ? sqlException.Number switch
            {
                2601 or 2627 => "That jersey number is already assigned on the selected team.",
                547 => "The selected team or another related record is no longer available. Refresh the page and try again.",
                _ => "Unable to save the player because the database rejected the changes. Please try again."
            }
            : "Unable to save the player because the database rejected the changes. Please try again.";
    }

    private sealed class PlayerInput
    {
        [Required, StringLength(100)]
        public string FirstName { get; set; } = string.Empty;

        [Required, StringLength(100)]
        public string LastName { get; set; } = string.Empty;

        [Required]
        public PlayerPosition Position { get; set; }

        [Range(1, 99)]
        public int JerseyNumber { get; set; }

        [Required, Range(1, int.MaxValue)]
        public int TeamId { get; set; }
    }

    private sealed class TeamOption
    {
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string Tournament { get; set; } = string.Empty;
    }
}
