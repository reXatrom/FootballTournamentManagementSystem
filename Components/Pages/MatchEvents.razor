@page "/match-events"
@rendermode InteractiveServer
@using FootballTournamentManagementSystem.Data
@using FootballTournamentManagementSystem.Models
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@inject ICurrentUserDbContextFactory DbFactory
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Match Events</PageTitle>

@if (Saved == "1")
{
    <p class="panel-muted">Changes saved.</p>
}

<div class="page-heading">
    <div>
        <p class="eyebrow">Live match detail</p>
        <h1 class="page-title">Match events</h1>
        <p class="page-subtitle">Review goals, cards, substitutions, and assists.</p>
    </div>
    <a class="btn btn-primary" href="/match-events/create">Record event</a>
</div>

@if (errorMessage is not null)
{
    <section class="empty-state"><h2>Unable to load match events</h2><p>@errorMessage</p></section>
}
else if (events is null)
{
    <p>Loading match events...</p>
}
else if (events.Count == 0)
{
    <section class="empty-state">
        <h2>No match events yet</h2>
        <p>Record an event after scheduling a match and registering players.</p>
    </section>
}
else
{
    <div class="event-list">
        @foreach (var tournamentGroup in events.GroupBy(item => item.Match.TournamentId))
        {
            var tournament = tournamentGroup.First().Match.Tournament;
            <section>
                <div class="league-heading">
                    <div>
                        <p class="eyebrow">League</p>
                        <h2>@tournament.Name</h2>
                        <p>@tournament.Location</p>
                    </div>
                </div>

                <div class="event-list">
                    @foreach (var matchGroup in tournamentGroup.GroupBy(item => item.MatchId))
                    {
                        var match = matchGroup.First().Match;
                        <section class="event-group">
                            <div class="event-group-heading">
                                <h2>@match.HomeTeam.Name vs @match.AwayTeam.Name</h2>
                                <span>@match.MatchDate.ToString("MMM d, yyyy")</span>
                            </div>

                            @foreach (var matchEvent in matchGroup.OrderBy(item => item.Minute ?? 121))
                            {
                                <div class="event-row">
                                    <a href="/match-events/@matchEvent.Id">Details</a>
                                    <span>Created by @matchEvent.CreatedByUser.FullName · @matchEvent.CreatedAt.ToLocalTime().ToString("g")</span>
                                    <span class="event-minute">@(matchEvent.Minute is null ? "-" : $"{matchEvent.Minute}'")</span>
                                    <strong>@matchEvent.EventType</strong>
                                    <span>@matchEvent.GoalScorer.FirstName @matchEvent.GoalScorer.LastName</span>
                                    @if (matchEvent.AssistedByPlayer is not null)
                                    {
                                        <span>Assist: @matchEvent.AssistedByPlayer.FirstName @matchEvent.AssistedByPlayer.LastName</span>
                                    }
                                    @if (CanManage(matchEvent))
                                    {
                                        <a href="/match-events/edit/@matchEvent.Id">Edit</a>
                                        <a href="/match-events/delete/@matchEvent.Id">Delete</a>
                                    }
                                </div>
                            }
                        </section>
                    }
                </div>
            </section>
        }
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "saved")]
    public string? Saved { get; set; }

    private List<MatchEvent>? events;
    private string? errorMessage;
    private string? currentUserId;
    private bool isAdmin;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
            currentUserId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            isAdmin = user.IsInRole("Admin");

            await using var db = await DbFactory.CreateDbContextAsync();
            events = await db.MatchEvents
                .AsNoTracking()
                .Include(item => item.CreatedByUser)
                .Include(item => item.Match).ThenInclude(match => match.HomeTeam)
                .Include(item => item.Match).ThenInclude(match => match.AwayTeam)
                .Include(item => item.Match).ThenInclude(match => match.Tournament)
                .Include(item => item.GoalScorer)
                .Include(item => item.AssistedByPlayer)
                .OrderBy(item => item.Match.Tournament.StartDate)
                .ThenBy(item => item.Match.MatchDate)
                .ThenBy(item => item.Minute ?? 121)
                .ToListAsync();
        }
        catch
        {
            errorMessage = "Please try again later.";
        }
    }

    private bool CanManage(IOwnedRecord record) => isAdmin || record.CreatedByUserId == currentUserId;
}
