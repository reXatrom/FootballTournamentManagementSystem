@page "/players"
@rendermode InteractiveServer
@using FootballTournamentManagementSystem.Data
@using FootballTournamentManagementSystem.Models
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@inject ICurrentUserDbContextFactory DbFactory
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Players</PageTitle>

@if (Saved == "1")
{
    <p class="panel-muted">Changes saved.</p>
}

<div class="page-heading">
    <div>
        <p class="eyebrow">Team rosters</p>
        <h1 class="page-title">Players</h1>
        <p class="page-subtitle">Browse registered players and their positions.</p>
    </div>
    <a class="btn btn-primary" href="/players/create">Add player</a>
</div>

@if (errorMessage is not null)
{
    <section class="empty-state"><h2>Unable to load players</h2><p>@errorMessage</p></section>
}
else if (players is null)
{
    <p>Loading players...</p>
}
else if (players.Count == 0)
{
    <section class="empty-state">
        <h2>No players yet</h2>
        <p>Add players to a team to build the tournament rosters.</p>
    </section>
}
else
{
    <div class="league-list">
        @foreach (var teamGroup in players.GroupBy(player => player.TeamId))
        {
            var team = teamGroup.First().Team;
            <section class="standings-panel">
            <div class="panel-heading">
                <div>
                    <p class="eyebrow">@team.Tournament.Name</p>
                    <h2>@team.Name</h2>
                </div>
                <span class="panel-muted">@teamGroup.Count() players</span>
            </div>
            <div class="player-table-wrapper">
                <table class="player-table">
                    <thead>
                        <tr>
                            <th>Player</th>
                            <th>Position</th>
                            <th>Number</th>
                            <th>Created by</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var player in teamGroup.OrderBy(item => item.JerseyNumber))
                        {
                            <tr>
                                <td><strong>@player.FirstName @player.LastName</strong></td>
                                <td>@player.Position</td>
                                <td><span class="jersey-number">@player.JerseyNumber</span></td>
                                <td>@player.CreatedByUser.FullName · @player.CreatedAt.ToLocalTime().ToString("g")</td>
                                <td>
                                    <a href="/players/@player.Id">Details</a>
                                    @if (CanManage(player))
                                    {
                                            <a href="/players/edit/@player.Id">Edit</a>
                                            <a href="/players/delete/@player.Id">Delete</a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            </section>
        }
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "saved")]
    public string? Saved { get; set; }

    private List<Player>? players;
    private string? errorMessage;
    private string? currentUserId;
    private bool isAdmin;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
            currentUserId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            isAdmin = user.IsInRole("Admin");
            await using var db = await DbFactory.CreateDbContextAsync();
            players = await db.Players
                .AsNoTracking()
                .Include(player => player.Team)
                .ThenInclude(team => team.Tournament)
                .Include(player => player.CreatedByUser)
                .OrderBy(player => player.Team.Name)
                .ThenBy(player => player.JerseyNumber)
                .ToListAsync();
        }
        catch
        {
            errorMessage = "Please try again later.";
        }
    }

    private bool CanManage(IOwnedRecord record) => isAdmin || record.CreatedByUserId == currentUserId;
}
